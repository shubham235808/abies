// Phase 0 schema: Identity & Access, Patients, Doctor/Provider Network.
// See docs/DOMAIN-MODEL.md for the full target model and docs/DECISIONS.md
// (D3) for which fields are ported verbatim from the validated Sprint 3
// baseline vs. net-new. Later phases add Appointments, Care Plans,
// Diagnostics, Medicines, Panchakarma, Payments, Support, etc. in their own
// reviewable migrations.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL lives in prisma.config.ts (CLI/migrate) and is
// passed to a driver adapter at PrismaClient construction time (src/lib/db.ts)
// — no `url` here. See https://pris.ly/d/prisma7-client-config.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & Access
// ---------------------------------------------------------------------------

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
  LAB
  PHARMACY
  PANCHAKARMA_CENTRE
  CUSTOMER_SUPPORT
  TECH_SUPPORT
  SALES
  CARE_COORDINATOR
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DISABLED
}

enum StaffDepartment {
  CUSTOMER_SUPPORT
  TECH_SUPPORT
  SALES
  CARE_COORDINATION
  ADMIN_OPERATIONS
}

model User {
  id                         String                      @id @default(cuid())
  mobile                     String                      @unique
  email                      String?                     @unique
  role                       UserRole                    @default(PATIENT)
  status                     UserStatus                  @default(ACTIVE)
  mfaEnabled                 Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  patientProfile             PatientProfile?
  doctorProfile              DoctorProfile?
  diagnosticLab              DiagnosticLab?
  pharmacy                   Pharmacy?
  panchakarmaCentre          PanchakarmaCentre?
  staffProfile               StaffProfile?
  sessions                   Session[]
  consentRecords             ConsentRecord[]
  auditEvents                AuditEvent[]
  appointments               Appointment[]
  consultations              Consultation[]
  prescriptions              Prescription[]
  payments                   Payment[]
  notifications              Notification[]
  carePlans                  CarePlan[]
  carePlanItemsOwned         CarePlanItem[]
  diagnosticRecommendations  DiagnosticRecommendation[]
  diagnosticOrders           DiagnosticOrder[]
  reports                    Report[]
  medicineOrders             MedicineOrder[]
  panchakarmaRecommendations PanchakarmaRecommendation[]
  panchakarmaBookings        PanchakarmaBooking[]

  @@index([role, status])
}

// Non-patient/non-doctor operational roles (LAB, PHARMACY,
// PANCHAKARMA_CENTRE, CUSTOMER_SUPPORT, TECH_SUPPORT, SALES,
// CARE_COORDINATOR). Partner-facing roles link to their organization once
// the corresponding module (diagnostics/medicines/panchakarma) is built;
// organizationId stays generic (string) here so this table doesn't need to
// change shape when those modules land.
model StaffProfile {
  id             String           @id @default(cuid())
  userId         String           @unique
  department     StaffDepartment?
  organizationId String?
  title          String?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([organizationId])
}

model OtpChallenge {
  id          String    @id @default(cuid())
  mobile      String
  role        UserRole
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([mobile, createdAt])
}

// Opaque cookie session. The cookie itself carries only a random token;
// this row is looked up by its hash on every request (see src/server/session.ts).
// mfaVerified gates privileged admin actions per docs/TARGET-ARCHITECTURE.md.
model Session {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  mfaVerified Boolean   @default(false)
  expiresAt   DateTime
  revokedAt   DateTime?
  ip          String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model ConsentArtifact {
  id        String          @id @default(cuid())
  key       String
  version   String
  title     String
  bodyUrl   String?
  required  Boolean         @default(true)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  records   ConsentRecord[]

  @@unique([key, version])
}

model ConsentRecord {
  id          String          @id @default(cuid())
  userId      String
  artifactId  String
  acceptedAt  DateTime        @default(now())
  withdrawnAt DateTime?
  ip          String?
  userAgent   String?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifact    ConsentArtifact @relation(fields: [artifactId], references: [id], onDelete: Restrict)

  @@unique([userId, artifactId])
  @@index([userId])
}

model AuditEvent {
  id           String   @id @default(cuid())
  userId       String?
  sessionId    String?
  eventType    String
  resourceType String?
  resourceId   String?
  action       String
  method       String?
  path         String?
  statusCode   Int?
  ip           String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
}

// ---------------------------------------------------------------------------
// Patients
// ---------------------------------------------------------------------------

enum FamilyRelation {
  PARENT
  SPOUSE
  CHILD
  DEPENDENT
  OTHER
}

model PatientProfile {
  id                 String         @id @default(cuid())
  userId             String         @unique
  firstName          String?
  lastName           String?
  dateOfBirth        DateTime?
  gender             String?
  phone              String?
  address            String?
  city               String?
  state              String?
  pin                String?
  preferredLanguage  String         @default("English")
  emergencyContact   String?
  allergies          String[]       @default([])
  medicalHistory     String?
  consentPreferences Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMembers      FamilyMember[]
}

model FamilyMember {
  id               String          @id @default(cuid())
  patientProfileId String
  name             String
  relation         FamilyRelation
  dateOfBirth      DateTime?
  gender           String?
  mobile           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  patientProfile   PatientProfile  @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  appointments     Appointment[]
  carePlans        CarePlan[]
  medicineOrders   MedicineOrder[]

  @@index([patientProfileId])
}

// ---------------------------------------------------------------------------
// Doctor / Provider Network
// ---------------------------------------------------------------------------

enum DoctorVerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum DoctorDocumentType {
  REGISTRATION_CERTIFICATE
  DEGREE_CERTIFICATE
  ID_PROOF
  PROFILE_PHOTO
  OTHER
}

enum DoctorDocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ConsultationMode {
  VIDEO
  CLINIC
}

model DoctorProfile {
  id                         String                      @id @default(cuid())
  userId                     String                      @unique
  slug                       String                      @unique
  title                      String                      @default("Dr.")
  firstName                  String?
  lastName                   String?
  gender                     String?
  bio                        String?
  registrationCouncil        String?
  registrationNumber         String?
  registrationYear           Int?
  primaryQualification       String?
  highestQualification       String?
  graduationInstitution      String?
  graduationYear             Int?
  yearsExperience            Int?
  specialties                String[]                    @default([])
  languages                  String[]                    @default([])
  consultationModes          ConsultationMode[]          @default([VIDEO])
  videoFee                   Int?
  clinicFee                  Int?
  rating                     Float                       @default(0)
  reviewCount                Int                         @default(0)
  isAcceptingNewPatients     Boolean                     @default(true)
  verificationStatus         DoctorVerificationStatus    @default(DRAFT)
  isDiscoverable             Boolean                     @default(false)
  submittedAt                DateTime?
  reviewedAt                 DateTime?
  reviewedByUserId           String?
  rejectionReason            String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  user                       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents                  DoctorDocument[]
  clinics                    DoctorClinic[]
  availability               DoctorAvailability[]
  verificationActions        DoctorVerificationAction[]
  appointmentSlots           AppointmentSlot[]
  appointments               Appointment[]
  consultations              Consultation[]
  prescriptions              Prescription[]
  carePlans                  CarePlan[]
  diagnosticRecommendations  DiagnosticRecommendation[]
  panchakarmaRecommendations PanchakarmaRecommendation[]

  @@unique([registrationCouncil, registrationNumber])
  @@index([verificationStatus, isDiscoverable])
  @@index([lastName, firstName])
}

model DoctorDocument {
  id              String               @id @default(cuid())
  doctorProfileId String
  type            DoctorDocumentType
  status          DoctorDocumentStatus @default(PENDING)
  originalName    String
  storedName      String
  mimeType        String
  sizeBytes       Int
  storagePath     String
  reviewNote      String?
  verifiedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  doctorProfile   DoctorProfile        @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId, type])
}

model DoctorClinic {
  id               String               @id @default(cuid())
  doctorProfileId  String
  name             String
  addressLine1     String
  addressLine2     String?
  city             String
  state            String
  postalCode       String
  phone            String?
  latitude         Float?
  longitude        Float?
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  doctorProfile    DoctorProfile        @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  availability     DoctorAvailability[]
  appointmentSlots AppointmentSlot[]
  appointments     Appointment[]

  @@index([doctorProfileId, active])
  @@index([city, state])
}

model DoctorAvailability {
  id              String           @id @default(cuid())
  doctorProfileId String
  dayOfWeek       Int
  startTime       String
  endTime         String
  slotMinutes     Int              @default(30)
  mode            ConsultationMode
  // Required when mode=CLINIC (enforced in modules/doctors/doctors.service.ts)
  // — a CLINIC window has to say which of the doctor's clinics it's at so
  // appointment-slot generation (modules/appointments) knows where the
  // visit happens. Left off VIDEO windows, which have no location.
  clinicId        String?
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  doctorProfile   DoctorProfile    @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  clinic          DoctorClinic?    @relation(fields: [clinicId], references: [id], onDelete: SetNull)

  @@index([doctorProfileId, dayOfWeek, active])
  @@index([clinicId])
}

model DoctorVerificationAction {
  id              String                    @id @default(cuid())
  doctorProfileId String
  adminUserId     String
  fromStatus      DoctorVerificationStatus?
  toStatus        DoctorVerificationStatus
  notes           String?
  createdAt       DateTime                  @default(now())
  doctorProfile   DoctorProfile             @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@index([doctorProfileId, createdAt])
  @@index([adminUserId, createdAt])
}

// ---------------------------------------------------------------------------
// Appointments, Payments, Notifications
// docs/DOMAIN-MODEL.md §4, §11, §13.
// ---------------------------------------------------------------------------

enum AppointmentSlotStatus {
  OPEN
  HELD
  BOOKED
}

enum AppointmentStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  RESCHEDULED
  COMPLETED
  NO_SHOW
}

// A slot row is only materialized the first time a patient tries to hold
// it (docs/DOMAIN-MODEL.md §4: "generated from DoctorAvailability on
// demand, not pre-materialized forever"); it does not exist for every open
// slot a doctor's weekly availability implies. The unique constraint plus
// hold-creation's conditional UPDATE (modules/appointments/appointments.service.ts)
// is what actually prevents double-booking — this model just gives that
// UPDATE a row to lock.
model AppointmentSlot {
  id              String                @id @default(cuid())
  doctorProfileId String
  clinicId        String?
  mode            ConsultationMode
  startsAt        DateTime
  endsAt          DateTime
  status          AppointmentSlotStatus @default(OPEN)
  heldByUserId    String?
  heldUntil       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  doctorProfile   DoctorProfile         @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  clinic          DoctorClinic?         @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  appointments    Appointment[]

  @@unique([doctorProfileId, startsAt, mode])
  @@index([doctorProfileId, status])
}

model Appointment {
  id                          String            @id @default(cuid())
  patientUserId               String
  careRecipientFamilyMemberId String?
  doctorProfileId             String
  // Not @unique: a cancelled appointment frees its AppointmentSlot back to
  // OPEN (modules/appointments/appointments.service.ts) so another patient
  // can book the same calendar slot — one slot can accumulate several
  // Appointment rows over time (at most one non-cancelled at a time, which
  // AppointmentSlot.status enforces, not this FK).
  slotId                      String
  mode                        ConsultationMode
  clinicId                    String?
  scheduledAt                 DateTime
  durationMinutes             Int
  status                      AppointmentStatus @default(PENDING_PAYMENT)
  reasonForVisit              String?
  paymentId                   String?           @unique
  cancelledAt                 DateTime?
  cancelledBy                 String?
  cancellationReason          String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  patientUser                 User              @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  careRecipientFamilyMember   FamilyMember?     @relation(fields: [careRecipientFamilyMemberId], references: [id], onDelete: SetNull)
  doctorProfile               DoctorProfile     @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  slot                        AppointmentSlot   @relation(fields: [slotId], references: [id], onDelete: Restrict)
  clinic                      DoctorClinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  payment                     Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  consultation                Consultation?

  @@index([patientUserId, status])
  @@index([doctorProfileId, scheduledAt])
  @@index([slotId])
}

enum PaymentPurpose {
  CONSULTATION
  DIAGNOSTIC_ORDER
  MEDICINE_ORDER
  PANCHAKARMA_BOOKING
  PACKAGE
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// amount is in rupees (whole units), matching DoctorProfile.videoFee/clinicFee
// — the Razorpay adapter (src/lib/payments/razorpay.ts) is the one place
// that converts to paise, right before the gateway call.
model Payment {
  id                 String              @id @default(cuid())
  payerUserId        String
  purpose            PaymentPurpose
  purposeEntityId    String
  amount             Int
  currency           String              @default("INR")
  status             PaymentStatus       @default(CREATED)
  gateway            String              @default("razorpay")
  gatewayOrderId     String?             @unique
  gatewayPaymentId   String?             @unique
  gatewaySignature   String?
  verifiedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  payer              User                @relation(fields: [payerUserId], references: [id], onDelete: Cascade)
  appointment        Appointment?
  diagnosticOrder    DiagnosticOrder?
  medicineOrder      MedicineOrder?
  panchakarmaBooking PanchakarmaBooking?

  @@index([payerUserId, status])
  @@index([purpose, purposeEntityId])
}

enum NotificationChannel {
  SMS
  EMAIL
  WHATSAPP
  IN_APP
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  READ
}

model Notification {
  id          String              @id @default(cuid())
  userId      String
  channel     NotificationChannel
  templateKey String
  payload     Json
  status      NotificationStatus  @default(QUEUED)
  providerRef String?
  error       String?
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Consultations, clinical notes, prescriptions
// docs/DOMAIN-MODEL.md §5.
// ---------------------------------------------------------------------------

enum ConsultationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// One per CONFIRMED Appointment — created automatically when payment is
// verified (modules/appointments/appointments.service.ts), so there's
// always somewhere for a doctor to record notes even before the visit
// technically "starts". Video-call infrastructure isn't connected in this
// environment (see VideoSession below); everything else here is real.
model Consultation {
  id                         String                      @id @default(cuid())
  appointmentId              String                      @unique
  doctorProfileId            String
  patientUserId              String
  startedAt                  DateTime?
  endedAt                    DateTime?
  chiefComplaint             String?
  historyOfPresentIllness    String?
  notes                      String?
  status                     ConsultationStatus          @default(SCHEDULED)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  appointment                Appointment                 @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorProfile              DoctorProfile               @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  patientUser                User                        @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  videoSession               VideoSession?
  clinicalNote               ClinicalNote?
  prescriptions              Prescription[]
  carePlans                  CarePlan[]
  diagnosticRecommendations  DiagnosticRecommendation[]
  panchakarmaRecommendations PanchakarmaRecommendation[]

  @@index([doctorProfileId, status])
  @@index([patientUserId, status])
}

// Configurable so the Ayurveda assessment shape (seeded with Prakriti,
// Vikriti, Agni, Koshta — prisma/seed.ts) isn't hard-coded into
// ClinicalNote.ayurvedaAssessment's json, per the brief's explicit
// instruction. fieldType is a plain string ('text' | 'select' | 'textarea')
// rather than an enum so adding a new field type never needs a migration.
model AssessmentTemplateField {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  fieldType String
  options   String[] @default([])
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClinicalNote {
  id                 String       @id @default(cuid())
  consultationId     String       @unique
  ayurvedaAssessment Json         @default("{}")
  diagnosis          String?
  treatmentPlan      String?
  recommendations    String?
  followUpDate       DateTime?
  finalizedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  consultation       Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

enum VideoProvider {
  MOCK
}

// provider is deliberately a closed enum of one value today — adding a real
// provider (Twilio/Daily/etc.) is a schema-visible decision, not a silent
// env-var switch, because provider credentials never live on this
// patient/doctor-visible row (docs/DOMAIN-MODEL.md §5) — the adapter
// (src/lib/video) resolves join tokens server-side, per request.
model VideoSession {
  id                 String        @id @default(cuid())
  consultationId     String        @unique
  provider           VideoProvider @default(MOCK)
  providerSessionRef String?
  joinWindowStart    DateTime?
  joinWindowEnd      DateTime?
  patientJoinedAt    DateTime?
  doctorJoinedAt     DateTime?
  endedAt            DateTime?
  failureReason      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  consultation       Consultation  @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

enum PrescriptionStatus {
  DRAFT
  FINALIZED
  SUPERSEDED
}

model Prescription {
  id              String             @id @default(cuid())
  consultationId  String
  doctorProfileId String
  patientUserId   String
  status          PrescriptionStatus @default(DRAFT)
  finalizedAt     DateTime?
  // Set on the NEW row when it's a correction of an older FINALIZED one,
  // which is marked SUPERSEDED at the same time — the old row and its
  // items are never mutated (modules/consultations/prescriptions.service.ts).
  supersedesId    String?            @unique
  doctorNotes     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  consultation    Consultation       @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  doctorProfile   DoctorProfile      @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  patientUser     User               @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  supersedes      Prescription?      @relation("PrescriptionCorrection", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy    Prescription?      @relation("PrescriptionCorrection")
  items           PrescriptionItem[]
  medicineOrders  MedicineOrder[]

  @@index([consultationId])
  @@index([patientUserId, status])
  @@index([doctorProfileId, status])
}

// medicineId is resolved automatically at finalizePrescription time
// (modules/consultations/prescriptions.service.ts calls
// modules/medicines/catalogue.service.ts's resolveMedicineByName, which
// finds-or-creates a Medicine by case-insensitive name match) — free-text
// productName stays the field doctors actually type and what always
// renders; medicineId is what lets a finalized item become a
// MedicineOrderItem later (docs/DOMAIN-MODEL.md §5: "may reference an
// unlisted/compounded product by free-text name" — draft items stay
// unresolved, only a FINALIZED prescription's items get a medicineId).
model PrescriptionItem {
  id                 String              @id @default(cuid())
  prescriptionId     String
  medicineId         String?
  productName        String
  dosage             String?
  frequency          String?
  durationDays       Int?
  route              String?
  instructions       String?
  startDate          DateTime?
  endDate            DateTime?
  prescription       Prescription        @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine           Medicine?           @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineOrderItems MedicineOrderItem[]

  @@index([prescriptionId])
}

// ---------------------------------------------------------------------------
// Care Plan Engine — central orchestration layer
// docs/DOMAIN-MODEL.md §6.
// ---------------------------------------------------------------------------

enum CarePlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  SUPERSEDED
}

// consultationId is nullable — a plan may originate outside a single
// consultation (docs/DOMAIN-MODEL.md §6) — but doctorProfileId (the
// clinical owner) is always required: every plan has an accountable
// clinician even when it wasn't authored during one specific visit.
model CarePlan {
  id                          String         @id @default(cuid())
  patientUserId               String
  careRecipientFamilyMemberId String?
  doctorProfileId             String
  consultationId              String?
  startDate                   DateTime
  targetDate                  DateTime?
  status                      CarePlanStatus @default(DRAFT)
  summary                     String?
  goals                       String[]       @default([])
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  patientUser                 User           @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  careRecipientFamilyMember   FamilyMember?  @relation(fields: [careRecipientFamilyMemberId], references: [id], onDelete: SetNull)
  doctorProfile               DoctorProfile  @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  consultation                Consultation?  @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  items                       CarePlanItem[]

  @@index([patientUserId, status])
  @@index([doctorProfileId, status])
}

enum CarePlanItemType {
  CONSULTATION
  DIAGNOSTIC
  MEDICINE
  PANCHAKARMA
  LIFESTYLE
  DIET
  FOLLOW_UP
  TASK
  MILESTONE
}

// Clinician-owned (docs/DOMAIN-MODEL.md §6: only the plan's doctor, or an
// explicit hand-off, may set this) — kept deliberately separate from
// patientMarkedDoneAt below, which is the patient's own "I did this"
// acknowledgement and never changes clinical status on its own.
enum CarePlanItemStatus {
  PLANNED
  ACTIVE
  COMPLETED
  MISSED
  CANCELLED
}

enum CarePlanRelatedEntityType {
  CONSULTATION
  DIAGNOSTIC_ORDER
  MEDICINE_ORDER
  PANCHAKARMA_BOOKING
  TASK
}

// relatedEntityId has no DB-level FK — it's polymorphic across four
// different tables depending on relatedEntityType (same pattern as
// Payment.purposeEntityId). CONSULTATION and TASK (no external entity —
// the item itself is the task) are usable today; DIAGNOSTIC_ORDER,
// MEDICINE_ORDER and PANCHAKARMA_BOOKING all now have backing tables
// (Phases 7-9) but still go through relatedEntityId/relatedEntityType
// rather than a typed FK, same as CONSULTATION/TASK.
model CarePlanItem {
  id                         String                      @id @default(cuid())
  carePlanId                 String
  type                       CarePlanItemType
  title                      String
  description                String?
  status                     CarePlanItemStatus          @default(PLANNED)
  startDate                  DateTime?
  dueDate                    DateTime?
  completedDate              DateTime?
  relatedEntityType          CarePlanRelatedEntityType?
  relatedEntityId            String?
  ownerUserId                String?
  notes                      String?
  patientMarkedDoneAt        DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  carePlan                   CarePlan                    @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  owner                      User?                       @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  diagnosticRecommendations  DiagnosticRecommendation[]
  panchakarmaRecommendations PanchakarmaRecommendation[]

  @@index([carePlanId])
  @@index([ownerUserId])
}

// ---------------------------------------------------------------------------
// Diagnostics — deliberately separate from Reports (docs/DOMAIN-MODEL.md §7,
// explicit blueprint rule). One DiagnosticLab per LAB-role User, same 1:1
// shape as DoctorProfile — a real multi-staff-per-lab-org model would need
// its own onboarding/permissions layer (StaffProfile.organizationId is
// already reserved for that per its Phase 0 comment); out of scope here.
// No DiagnosticPackage yet (Phase 0 domain model allows testId/packageId
// both nullable on recommendations/order-items specifically so this can
// land without a schema change later) — every order line item is a single
// DiagnosticTest for now.
// ---------------------------------------------------------------------------

enum DiagnosticLabVerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

// Mirrors DoctorVerificationStatus's shape (docs/DOMAIN-MODEL.md §7) but
// intentionally lighter — no per-document upload/review subsystem, since a
// lab's licenses are identifiers an admin can verify externally, not scans
// that need per-file review like a doctor's registration certificate.
model DiagnosticLab {
  id                      String                          @id @default(cuid())
  userId                  String                          @unique
  name                    String?
  licenseNumbers          String[]                        @default([])
  serviceCities           String[]                        @default([])
  homeCollectionSupported Boolean                         @default(false)
  active                  Boolean                         @default(true)
  verificationStatus      DiagnosticLabVerificationStatus @default(DRAFT)
  submittedAt             DateTime?
  reviewedAt              DateTime?
  reviewedByUserId        String?
  rejectionReason         String?
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  user                    User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tests                   DiagnosticTest[]
  orders                  DiagnosticOrder[]

  @@index([verificationStatus, active])
}

model DiagnosticTest {
  id                      String                     @id @default(cuid())
  labId                   String
  code                    String
  name                    String
  description             String?
  sampleType              String?
  preparationInstructions String?
  price                   Int
  turnaroundHours         Int?
  active                  Boolean                    @default(true)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  lab                     DiagnosticLab              @relation(fields: [labId], references: [id], onDelete: Cascade)
  orderItems              DiagnosticOrderItem[]
  recommendations         DiagnosticRecommendation[]

  @@index([labId, active])
}

enum DiagnosticRecommendationStatus {
  RECOMMENDED
  BOOKED
  FULFILLED
  CANCELLED
}

model DiagnosticRecommendation {
  id                   String                         @id @default(cuid())
  carePlanItemId       String?
  consultationId       String
  doctorProfileId      String
  patientUserId        String
  testId               String?
  clinicalReason       String?
  targetCompletionDate DateTime?
  status               DiagnosticRecommendationStatus @default(RECOMMENDED)
  createdAt            DateTime                       @default(now())
  updatedAt            DateTime                       @updatedAt
  carePlanItem         CarePlanItem?                  @relation(fields: [carePlanItemId], references: [id], onDelete: SetNull)
  consultation         Consultation                   @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  doctorProfile        DoctorProfile                  @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  patientUser          User                           @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  test                 DiagnosticTest?                @relation(fields: [testId], references: [id], onDelete: SetNull)
  orders               DiagnosticOrder[]

  @@index([patientUserId, status])
  @@index([doctorProfileId, status])
}

enum DiagnosticOrderStatus {
  BOOKED
  SCHEDULED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum DiagnosticCollectionMode {
  HOME
  LAB_VISIT
}

// recommendationId is NOT @unique: a cancelled order must not permanently
// block rebooking the same recommendation — the exact bug already found
// and fixed once this session for Appointment.slotId (docs/IMPLEMENTATION-STATUS.md
// Phase 4). "At most one active order per recommendation" is enforced in
// modules/diagnostics/orders.service.ts, not the DB schema.
model DiagnosticOrder {
  id                 String                    @id @default(cuid())
  recommendationId   String?
  patientUserId      String
  labId              String
  collectionMode     DiagnosticCollectionMode
  scheduledAt        DateTime?
  address            String?
  paymentId          String?                   @unique
  status             DiagnosticOrderStatus     @default(BOOKED)
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  recommendation     DiagnosticRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  patientUser        User                      @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  lab                DiagnosticLab             @relation(fields: [labId], references: [id], onDelete: Cascade)
  payment            Payment?                  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  items              DiagnosticOrderItem[]
  sampleCollection   SampleCollection?
  report             DiagnosticReport?

  @@index([recommendationId])
  @@index([patientUserId, status])
  @@index([labId, status])
}

model DiagnosticOrderItem {
  id                String          @id @default(cuid())
  diagnosticOrderId String
  testId            String?
  price             Int
  createdAt         DateTime        @default(now())
  diagnosticOrder   DiagnosticOrder @relation(fields: [diagnosticOrderId], references: [id], onDelete: Cascade)
  test              DiagnosticTest? @relation(fields: [testId], references: [id], onDelete: SetNull)

  @@index([diagnosticOrderId])
}

model SampleCollection {
  id                String          @id @default(cuid())
  diagnosticOrderId String          @unique
  collectorName     String?
  collectedAt       DateTime?
  sampleBarcode     String?
  qualityException  String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  diagnosticOrder   DiagnosticOrder @relation(fields: [diagnosticOrderId], references: [id], onDelete: Cascade)
}

model DiagnosticReport {
  id                   String          @id @default(cuid())
  diagnosticOrderId    String          @unique
  structuredResults    Json?
  documentStorageKey   String?
  releasedToPatientAt  DateTime?
  notifiedDoctorAt     DateTime?
  criticalFlag         Boolean         @default(false)
  doctorAcknowledgedAt DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  diagnosticOrder      DiagnosticOrder @relation(fields: [diagnosticOrderId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Reports — patient document library, deliberately a separate concept from
// diagnostic booking (docs/DOMAIN-MODEL.md §8). Only auto-populated from a
// released DiagnosticReport in this phase; patient-uploaded historical
// documents (sourceEntityId null) are schema-ready but not built yet.
// ---------------------------------------------------------------------------

enum ReportKind {
  DIAGNOSTIC_REPORT
  UPLOADED_HISTORICAL
  PRESCRIPTION
  CLINICAL_DOCUMENT
  DISCHARGE_SUMMARY
}

model Report {
  id                       String     @id @default(cuid())
  patientUserId            String
  kind                     ReportKind
  sourceEntityType         String?
  sourceEntityId           String?
  storageKey               String
  uploadedByUserId         String?
  attachedToConsultationId String?
  attachedToCarePlanId     String?
  createdAt                DateTime   @default(now())
  patientUser              User       @relation(fields: [patientUserId], references: [id], onDelete: Cascade)

  @@index([patientUserId, kind])
}

// ---------------------------------------------------------------------------
// Medicines & Pharmacy (docs/DOMAIN-MODEL.md §9). Unlike DiagnosticTest
// (Phase 7, deliberately lab-owned catalogue), Medicine here is a
// platform-wide reference list, not scoped to one pharmacy — a doctor
// writing a Prescription has no idea which pharmacy will eventually fill it,
// so PrescriptionItem.medicineId must point at a stable drug identity
// independent of any pharmacy. Pharmacies each hold their own stock of a
// given Medicine as PharmacyInventory batches (with expiry/batch tracking,
// which diagnostics never needed). The catalogue is built lazily: a
// doctor's free-text PrescriptionItem.productName is resolved to a Medicine
// row (find-by-name-or-create) when the prescription is finalized
// (modules/medicines/catalogue.service.ts resolveMedicineByName, called
// from modules/consultations/prescriptions.service.ts finalizePrescription),
// and a pharmacy can likewise create one directly when first stocking an
// OTC item. No Brand/Manufacturer join tables or MedicineOrderItemSubstitution
// audit trail yet (out of scope this phase, same "document the gap, don't
// build a stub table" call as Phase 7's DiagnosticPackage) — brand/
// manufacturer are plain descriptive strings on Medicine for now, and a
// substitution simply isn't offered as a fulfilment action.
// ---------------------------------------------------------------------------

model Medicine {
  id                   String              @id @default(cuid())
  name                 String
  genericName          String?
  form                 String?
  strength             String?
  manufacturerName     String?
  brandName            String?
  requiresPrescription Boolean             @default(true)
  active               Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  prescriptionItems    PrescriptionItem[]
  inventory            PharmacyInventory[]
  orderItems           MedicineOrderItem[]

  @@index([name])
}

enum PharmacyVerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

// Mirrors DiagnosticLab's verification shape (docs/DOMAIN-MODEL.md §9).
model Pharmacy {
  id                 String                     @id @default(cuid())
  userId             String                     @unique
  name               String?
  licenseNumbers     String[]                   @default([])
  serviceAreas       String[]                   @default([])
  active             Boolean                    @default(true)
  verificationStatus PharmacyVerificationStatus @default(DRAFT)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedByUserId   String?
  rejectionReason    String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory          PharmacyInventory[]
  orders             MedicineOrder[]

  @@index([verificationStatus, active])
}

model PharmacyInventory {
  id                String   @id @default(cuid())
  pharmacyId        String
  medicineId        String
  batchNumber       String
  expiryDate        DateTime
  quantityAvailable Int
  price             Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  pharmacy          Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicine          Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, medicineId, batchNumber])
  @@index([pharmacyId, medicineId])
}

// PENDING | ACCEPTED | PACKING | DISPATCHED | DELIVERED | CANCELLED is the
// brief's exact list — unlike DiagnosticOrder there is no separate
// "awaiting payment" state, so PENDING does double duty: an order sits at
// PENDING both before and after payment succeeds, and a pharmacy may only
// act on it (acceptOrder) once its Payment row is SUCCESS
// (modules/medicines/orders.service.ts). listMineAsPharmacy filters on
// payment status rather than order status for the same reason
// DiagnosticOrder's lab list excludes BOOKED.
enum MedicineOrderStatus {
  PENDING
  ACCEPTED
  PACKING
  DISPATCHED
  DELIVERED
  CANCELLED
}

model MedicineOrder {
  id                          String              @id @default(cuid())
  prescriptionId              String?
  patientUserId               String
  careRecipientFamilyMemberId String?
  pharmacyId                  String
  paymentId                   String?             @unique
  status                      MedicineOrderStatus @default(PENDING)
  deliveryAddress             String?
  cancelledAt                 DateTime?
  cancellationReason          String?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  prescription                Prescription?       @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  patientUser                 User                @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  careRecipientFamilyMember   FamilyMember?       @relation(fields: [careRecipientFamilyMemberId], references: [id], onDelete: SetNull)
  pharmacy                    Pharmacy            @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  payment                     Payment?            @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  items                       MedicineOrderItem[]
  shipment                    Shipment?

  @@index([patientUserId, status])
  @@index([pharmacyId, status])
}

model MedicineOrderItem {
  id                 String            @id @default(cuid())
  medicineOrderId    String
  prescriptionItemId String?
  medicineId         String
  batchNumber        String
  quantity           Int
  unitPrice          Int
  createdAt          DateTime          @default(now())
  medicineOrder      MedicineOrder     @relation(fields: [medicineOrderId], references: [id], onDelete: Cascade)
  prescriptionItem   PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id], onDelete: SetNull)
  medicine           Medicine          @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  @@index([medicineOrderId])
}

model Shipment {
  id              String        @id @default(cuid())
  medicineOrderId String        @unique
  carrier         String?
  trackingRef     String?
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  medicineOrder   MedicineOrder @relation(fields: [medicineOrderId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Panchakarma (docs/DOMAIN-MODEL.md §10). Same partner-verification shape as
// DiagnosticLab/Pharmacy, and PanchakarmaRecommendation deliberately mirrors
// DiagnosticRecommendation's shape (the domain model says so explicitly).
// No TherapyPackage yet — same "document the gap, don't build an unused
// stub table" call as Phase 7's DiagnosticPackage and Phase 8's
// Brand/Manufacturer tables; a booking is always for one Therapy, and
// sessionCount already carries the "course of N sessions" concept without
// needing a separate bundled-package entity.
// ---------------------------------------------------------------------------

enum PanchakarmaCentreVerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model PanchakarmaCentre {
  id                      String                              @id @default(cuid())
  userId                  String                              @unique
  name                    String?
  addressLine1            String?
  city                    String?
  state                   String?
  postalCode              String?
  supervisingPractitioner String?
  licenseNumbers          String[]                            @default([])
  active                  Boolean                             @default(true)
  verificationStatus      PanchakarmaCentreVerificationStatus @default(DRAFT)
  submittedAt             DateTime?
  reviewedAt              DateTime?
  reviewedByUserId        String?
  rejectionReason         String?
  createdAt               DateTime                            @default(now())
  updatedAt               DateTime                            @updatedAt
  user                    User                                @relation(fields: [userId], references: [id], onDelete: Cascade)
  therapies               Therapy[]
  therapists              Therapist[]
  bookings                PanchakarmaBooking[]

  @@index([verificationStatus, active])
}

model Therapy {
  id                  String                      @id @default(cuid())
  centreId            String
  name                String
  description         String?
  durationMinutes     Int?
  prerequisites       String?
  contraindications   String?
  price               Int
  requiredSupervision Boolean                     @default(false)
  active              Boolean                     @default(true)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  centre              PanchakarmaCentre           @relation(fields: [centreId], references: [id], onDelete: Cascade)
  recommendations     PanchakarmaRecommendation[]
  bookings            PanchakarmaBooking[]

  @@index([centreId, active])
}

model Therapist {
  id             String               @id @default(cuid())
  centreId       String
  name           String
  qualifications String?
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  centre         PanchakarmaCentre    @relation(fields: [centreId], references: [id], onDelete: Cascade)
  sessions       PanchakarmaSession[]

  @@index([centreId, active])
}

enum PanchakarmaRecommendationStatus {
  RECOMMENDED
  BOOKED
  FULFILLED
  CANCELLED
}

model PanchakarmaRecommendation {
  id                      String                          @id @default(cuid())
  carePlanItemId          String?
  consultationId          String
  doctorProfileId         String
  patientUserId           String
  therapyId               String?
  clinicalReason          String?
  sessionCountRecommended Int?
  status                  PanchakarmaRecommendationStatus @default(RECOMMENDED)
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt
  carePlanItem            CarePlanItem?                   @relation(fields: [carePlanItemId], references: [id], onDelete: SetNull)
  consultation            Consultation                    @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  doctorProfile           DoctorProfile                   @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  patientUser             User                            @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  therapy                 Therapy?                        @relation(fields: [therapyId], references: [id], onDelete: SetNull)
  bookings                PanchakarmaBooking[]

  @@index([patientUserId, status])
  @@index([doctorProfileId, status])
}

// PENDING-equivalent overload, same call as Phase 8's MedicineOrderStatus:
// the brief's exact list includes RECOMMENDED (inherited from the
// vocabulary it shares with PanchakarmaRecommendationStatus), but a
// PanchakarmaBooking row is only ever created once a patient actually
// books, so RECOMMENDED is never a reachable state here in practice —
// bookings are created at BOOKED, which (like Phase 8's MedicineOrder
// PENDING) does double duty for both "awaiting payment" and "paid,
// awaiting the centre to schedule the first session"; Payment.status is
// what actually distinguishes the two (modules/panchakarma/bookings.service.ts).
enum PanchakarmaBookingStatus {
  RECOMMENDED
  BOOKED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// recommendationId is NOT @unique — same "cancel-and-rebook must not
// permanently block the recommendation" lesson as Appointment.slotId
// (Phase 4) and DiagnosticOrder.recommendationId (Phase 7).
model PanchakarmaBooking {
  id                 String                     @id @default(cuid())
  recommendationId   String?
  centreId           String
  patientUserId      String
  therapyId          String
  sessionCount       Int
  paymentId          String?                    @unique
  status             PanchakarmaBookingStatus   @default(BOOKED)
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  recommendation     PanchakarmaRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  centre             PanchakarmaCentre          @relation(fields: [centreId], references: [id], onDelete: Cascade)
  patientUser        User                       @relation(fields: [patientUserId], references: [id], onDelete: Cascade)
  therapy            Therapy                    @relation(fields: [therapyId], references: [id], onDelete: Cascade)
  payment            Payment?                   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  sessions           PanchakarmaSession[]

  @@index([recommendationId])
  @@index([patientUserId, status])
  @@index([centreId, status])
}

model PanchakarmaSession {
  id            String             @id @default(cuid())
  bookingId     String
  sessionNumber Int
  therapistId   String?
  scheduledAt   DateTime
  attendedAt    DateTime?
  notes         String?
  exceptionFlag String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  booking       PanchakarmaBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  therapist     Therapist?         @relation(fields: [therapistId], references: [id], onDelete: SetNull)

  @@unique([bookingId, sessionNumber])
  @@index([bookingId])
}
