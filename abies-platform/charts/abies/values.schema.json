{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["images", "existingSecret", "app"],
  "properties": {
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "app": {
      "type": "object",
      "required": ["origin", "secureCookie"],
      "properties": {
        "origin": {
          "type": "string",
          "pattern": "^https?://[^/]+$"
        },
        "secureCookie": {
          "type": "boolean"
        }
      }
    },
    "images": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "web": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "backend": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
