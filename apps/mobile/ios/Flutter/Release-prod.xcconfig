// Base configuration for the Runner target's "Release-prod" build configuration.
// Flutter selects this configuration for `flutter build ios --flavor prod` in
// release mode (Release-<flavor> naming, flutter_tools ios/xcodeproj.dart).
// The Pods include is optional (`#include?`) so this is a no-op until a real
// `pod install` on a Mac generates it; CocoaPods names it after this
// configuration, lower-cased.
#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release-prod.xcconfig"
#include "Generated.xcconfig"
#include "Flavor-prod.xcconfig"
