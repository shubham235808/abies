// Base configuration for the Runner target's "Debug-uat" build configuration.
// Flutter selects this configuration for `flutter build ios --flavor uat` in
// debug mode (Debug-<flavor> naming, flutter_tools ios/xcodeproj.dart).
// The Pods include is optional (`#include?`) so this is a no-op until a real
// `pod install` on a Mac generates it; CocoaPods names it after this
// configuration, lower-cased.
#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug-uat.xcconfig"
#include "Generated.xcconfig"
#include "Flavor-uat.xcconfig"
