.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/

# pubspec.lock IS committed, deliberately — this is an app, not a published
# package, so the resolved dependency set should be reproducible, the same
# way package-lock.json/pnpm-lock.yaml are committed elsewhere in this repo.

# android/ was generated by `flutter create` (see README.md "Status") and is
# now real, committed project source — its own .gitignore (Gradle's own
# build/.gradle/local.properties exclusions) applies underneath it. ios/
# is committed too (its own ios/.gitignore covers Pods/ and generated files)
# but has never been built: this box has no macOS/Xcode
# (docs/mobile/APP-STORE-RELEASE.md).

# Signing material must never reach source control (docs/mobile/SECURITY-DESIGN.md §10).
**/key.properties
**/*.jks
**/*.keystore
**/*.mobileprovision
**/*.p12
# Widget Preview related
.widget_preview/
