# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development

# --- Database ---
POSTGRES_USER=abies
POSTGRES_PASSWORD=change-me
POSTGRES_DB=abies_ayurveda
DATABASE_URL=postgresql://abies:change-me@postgres:5432/abies_ayurveda?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Object storage (MinIO / S3-compatible) ---
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=abies-dev
STORAGE_SECRET_ACCESS_KEY=change-me-too
STORAGE_BUCKET=abies-private
STORAGE_FORCE_PATH_STYLE=true

# --- Session / auth ---
# 32+ byte random secret used to HMAC session tokens and OTP codes.
SESSION_SECRET=replace-with-openssl-rand-hex-32
OTP_PEPPER=replace-with-openssl-rand-hex-32
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
SESSION_TTL_DAYS=7
ADMIN_MFA_REQUIRED=true

# Non-production only: fixes the OTP/MFA code so dev/test doesn't need a real
# SMS/authenticator provider. Both are hard-disabled when NODE_ENV=production.
OTP_DEV_CODE=123456
EXPOSE_DEV_OTP=true
DEV_ADMIN_MFA_CODE=654321

# Doctors may self-register via OTP (subject to admin verification before
# going live) when true; when false, doctor accounts must be provisioned by
# an admin first.
ALLOW_DOCTOR_SELF_ONBOARDING=true

# --- Payments (Razorpay adapter) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Notifications ---
SMS_PROVIDER=mock
SMS_API_KEY=
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=

# --- Video consultation adapter ---
VIDEO_PROVIDER=mock
VIDEO_API_KEY=
VIDEO_API_SECRET=

# --- App ---
APP_BASE_URL=http://localhost:3000
UPLOAD_MAX_BYTES=10485760
