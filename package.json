{
  "name": "abies-ayurveda-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "pnpm --filter @abies/domain run prisma:generate",
    "prisma:migrate": "pnpm --filter @abies/domain run prisma:migrate",
    "prisma:deploy": "pnpm --filter @abies/domain run prisma:deploy",
    "prisma:seed": "pnpm --filter @abies/domain run prisma:seed",
    "db:reset": "pnpm --filter @abies/domain run db:reset"
  },
  "dependencies": {
    "@abies/design-system": "workspace:*",
    "@abies/domain": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^18.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
